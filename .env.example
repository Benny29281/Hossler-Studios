# Lokal
APP_URL=http://localhost:3000
DEMO_MODE=1
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL terkelola. Kosongkan untuk PGlite lokal.
DATABASE_URL=

# Midtrans Snap. Gunakan kunci sandbox untuk pengujian.
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=0

# Biteship. Isi alamat gudang dan kode kurir di /admin/settings.
BITESHIP_API_KEY=

# Resend
RESEND_API_KEY=
MAIL_FROM=

# Panggilan terjadwal GET /api/jobs dengan header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Opsional
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
INDEX_STORE=0
